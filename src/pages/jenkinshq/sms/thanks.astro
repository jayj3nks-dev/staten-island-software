---
import SMSLayout from '../../../layouts/JenkinsSMSLayout.astro';
import { siteConfig } from '../../../config/site';
---
<SMSLayout title="Consent & Inquiry Confirmed" description="Confirmation of your Staten Island Software / Jenkins HQ inquiry and SMS preferences.">
<p class="overline">Staten Island Software · Jenkins HQ</p>
<h1>Thank you — your request is confirmed</h1>
<p>We have received your submission and stored your communication preferences with timestamp and consent source in our system.</p>
<p id="consent-receipt-box" style="padding:0.85rem 1rem;border-radius:8px;border:1px solid #334155;background:#0f172a;font-size:0.95rem;">
  <strong>Consent confirmation:</strong> If you checked an optional SMS consent box, you will receive a confirmation SMS message from Staten Island Software / Jenkins HQ once our carrier campaign is active. Reply <strong>STOP</strong> at any time to opt out or <strong>HELP</strong> for support. Msg &amp; data rates may apply.
</p>
<p class="muted">Customer support: <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a> · <a href="/jenkinshq/privacy">Privacy Policy</a> · <a href="/jenkinshq/terms">SMS Terms</a></p>
<p><a href="/jenkinshq/sms">Return to the SMS Opt-In &amp; Support form</a></p>
<script>
const p = new URLSearchParams(window.location.search);
const receipt = p.get('receipt');
const box = document.getElementById('consent-receipt-box');
if (box && receipt) {
  const scopes = [];
  if (p.get('tx') === '1') scopes.push('Customer Service & Transactional SMS');
  if (p.get('mkt') === '1') scopes.push('Promotional & Product Release SMS');
  const scopeText = scopes.length ? scopes.join(' + ') : 'Email / Web Inquiry Only (No SMS Opt-In)';
  box.innerHTML = `<strong>Consent Receipt ID:</strong> <code>${receipt.replace(/[^a-zA-Z0-9_-]/g, '')}</code><br/><strong>Recorded Scope:</strong> ${scopeText}<br/>Reply <strong>STOP</strong> at any time to opt out of SMS or <strong>HELP</strong> for customer support. Msg &amp; data rates may apply.`;
}
</script>
</SMSLayout>
