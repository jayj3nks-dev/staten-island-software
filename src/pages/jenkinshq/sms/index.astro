---
import SMSLayout from '../../../layouts/JenkinsSMSLayout.astro';
import { siteConfig, hasPhone } from '../../../config/site';
---
<SMSLayout title="SMS Opt-In & Support" description="Contact Staten Island Software / Jenkins HQ and optionally opt in to customer service or marketing SMS updates.">
<p class="overline">Staten Island Software · Jenkins HQ</p>
<h1>Customer Support &amp; Optional SMS Opt-In</h1>
<p>Contact <strong>Str3am State LLC d/b/a Staten Island Software / Jenkins HQ</strong> (1016 Manor Road, Staten Island, NY 10314) about a customer service request, order update, consultation, or software project. You may separately opt in to text notifications below. <strong>SMS consent is optional and is never required to submit this form or purchase any product or service.</strong></p>

<div id="consent-status-banner" hidden role="status" style="margin:1rem 0;padding:1rem;border-radius:8px;border:1px solid #10b981;background:#064e3b;color:#ecfdf5;"></div>

<form id="jenkinshq-sms-form" name="jenkinshq-sms-optin" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/jenkinshq/sms/thanks" data-backend-endpoint={siteConfig.smsConsentEndpoint}>
  <input type="hidden" name="form-name" value="jenkinshq-sms-optin"/>
  <input type="hidden" name="consent-language-version" value="jenkinshq-signalwire-v2-2026-11-21"/>
  <p style="display:none"><label>Leave blank <input name="bot-field" tabindex="-1" autocomplete="off"/></label></p>
  <div class="panel">
    <label for="customer-name">Full name *</label>
    <input id="customer-name" name="name" autocomplete="name" maxlength="120" required/>

    <label for="customer-email">Email address *</label>
    <input id="customer-email" type="email" name="email" autocomplete="email" maxlength="254" required/>

    <label for="customer-business">Business / Organization (optional)</label>
    <input id="customer-business" name="business" autocomplete="organization" maxlength="120"/>

    <label for="customer-phone">US mobile phone number (required only if checking an SMS opt-in box below)</label>
    <input id="customer-phone" type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="+1 (718) 555-0199"/>

    <label for="customer-request">How can we help you? *</label>
    <textarea id="customer-request" name="request" rows="4" maxlength="2500" required></textarea>

    <fieldset>
      <legend>Optional SMS Consent (both unchecked by default)</legend>

      <label class="checkbox" for="customer-optin">
        <input id="customer-optin" type="checkbox" name="sms_opt_in" value="yes"/>
        <span>
          <strong>Customer Service, Order Updates &amp; Transactional SMS (Optional):</strong>
          I agree to receive recurring transactional and customer service text messages from <strong>Staten Island Software / Jenkins HQ</strong> regarding my support requests, order confirmations, fulfillment updates, and appointment reminders. Message frequency varies. Message and data rates may apply. Reply <strong>STOP</strong> to opt out at any time or <strong>HELP</strong> for help. Consent is not a condition of purchase. View our <a href="/jenkinshq/privacy">Privacy Policy</a> and <a href="/jenkinshq/terms">SMS Terms &amp; Conditions</a>.
        </span>
      </label>

      <label class="checkbox" for="customer-marketing-optin" style="margin-top:0.85rem;">
        <input id="customer-marketing-optin" type="checkbox" name="sms_marketing_opt_in" value="yes"/>
        <span>
          <strong>Promotional &amp; Product Release SMS (Optional):</strong>
          I separately agree to receive consent-based marketing and product announcement text messages from <strong>Staten Island Software / Jenkins HQ</strong> (up to 4 messages/month). Message and data rates may apply. Reply <strong>STOP</strong> to opt out at any time or <strong>HELP</strong> for help. Consent is not a condition of purchase. Mobile opt-in data is never shared with third parties or affiliates for marketing.
        </span>
      </label>
    </fieldset>

    <p id="phone-error" hidden role="alert" style="color:#f87171;font-weight:600;">Enter a valid 10-digit US mobile number to opt in to SMS notifications.</p>
    <button id="sms-submit-btn" type="submit">Submit Request &amp; Save Preferences</button>
    <p class="muted">
      You can submit your inquiry without checking either SMS box.
      Customer Support: <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
      {hasPhone ? ` · Business Phone: ${siteConfig.phone}` : ''}
      · <a href="/terms">Terms of Service</a> · <a href="/privacy">Privacy Policy</a>.
    </p>
  </div>
</form>

<script>
const form = document.getElementById('jenkinshq-sms-form') as HTMLFormElement | null;
form?.addEventListener('submit', async (event) => {
  const txChecked = Boolean(document.querySelector<HTMLInputElement>('#customer-optin')?.checked);
  const mktChecked = Boolean(document.querySelector<HTMLInputElement>('#customer-marketing-optin')?.checked);
  const phoneEl = document.querySelector<HTMLInputElement>('#customer-phone');
  const errorEl = document.getElementById('phone-error');
  const digits = (phoneEl?.value || '').replace(/\D/g, '');
  const validPhone = digits.length === 10 || (digits.length === 11 && digits.startsWith('1'));

  if ((txChecked || mktChecked) && !validPhone) {
    event.preventDefault();
    if (errorEl) errorEl.hidden = false;
    phoneEl?.focus();
    return;
  }
  if (errorEl) errorEl.hidden = true;

  event.preventDefault();
  const submitBtn = document.getElementById('sms-submit-btn') as HTMLButtonElement | null;
  if (submitBtn) {
    submitBtn.disabled = true;
    submitBtn.textContent = 'Recording preferences...';
  }

  const endpoint = form.getAttribute('data-backend-endpoint') || '';
  const formData = new FormData(form);
  let receiptId = '';

  // 1. Persist auditable consent record directly to Jenkins HQ backend CRM
  if (endpoint) {
    try {
      const apiRes = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          full_name: String(formData.get('name') || ''),
          email: String(formData.get('email') || ''),
          business_name: String(formData.get('business') || ''),
          phone: String(formData.get('phone') || ''),
          inquiry_notes: String(formData.get('request') || ''),
          transactional_opt_in: txChecked,
          marketing_opt_in: mktChecked,
          consent_source: window.location.href,
          disclosure_version: String(formData.get('consent-language-version') || 'jenkinshq-signalwire-v2-2026-11-21'),
          bot_field: String(formData.get('bot-field') || '')
        })
      });
      if (apiRes.ok) {
        const parsed = await apiRes.json();
        receiptId = parsed.consent_record_id || '';
      }
    } catch {
      // Fall through to Netlify Forms submission
    }
  }

  // 2. Also submit to Netlify Forms so inquiry is archived on Netlify
  try {
    await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: new URLSearchParams(formData as any).toString()
    });
  } catch {
    // Continue to confirmation page
  }

  const qs = new URLSearchParams();
  if (receiptId) qs.set('receipt', receiptId);
  if (txChecked) qs.set('tx', '1');
  if (mktChecked) qs.set('mkt', '1');
  window.location.href = '/jenkinshq/sms/thanks' + (qs.toString() ? `?${qs.toString()}` : '');
});
</script>
</SMSLayout>
