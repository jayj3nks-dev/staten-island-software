---
interface Props { title: string; description: string }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | JenkinsHQ</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,"https://statenislandsaas.netlify.app").toString()}/></head>
<body>
<a class="skip" href="#content">Skip to content</a>
<header><div class="wrap header"><a class="brand" href="/jenkinshq/sms">JENKINS<span>HQ</span></a><nav aria-label="SMS program"><a href="/jenkinshq/sms">Opt in</a><a href="/jenkinshq/privacy">Privacy</a><a href="/jenkinshq/terms">Terms</a></nav></div></header>
<main class="wrap" id="content"><slot/></main>
<footer class="wrap"><p>JenkinsHQ • Customer support and transactional SMS information</p><p><a href="/jenkinshq/privacy">Privacy Policy</a> · <a href="/jenkinshq/terms">SMS Terms</a> · <a href="mailto:Jeremi.Jenkins@gmail.com">Contact support</a></p></footer>
</body></html>
<style is:global>
:root{color-scheme:dark;font-family:Inter,system-ui,sans-serif;background:#081220;color:#ecf4ff}*{box-sizing:border-box}body{margin:0;line-height:1.7}a{color:#85d5ff}header{border-bottom:1px solid #2d4055;background:#0c1a2d}header .header{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:20px;padding-bottom:20px}.brand{font-size:1.3rem;text-decoration:none;letter-spacing:.08em;font-weight:900;color:#fff}.brand span{color:#38bdf8}nav{display:flex;gap:22px;flex-wrap:wrap}nav a{font-size:.95rem;text-decoration:none}.wrap{max-width:850px;margin:auto;padding:28px 22px}main{padding-top:55px;padding-bottom:72px;min-height:65vh}.overline{color:#7dd3fc;font-size:.84rem;text-transform:uppercase;letter-spacing:.15em;font-weight:750}h1{font-size:clamp(2rem,5vw,3rem);line-height:1.16;letter-spacing:-.025em;margin:.4rem 0 1.2rem}h2{font-size:1.35rem;margin-top:2.1rem}p,li{color:#c9d6e6}.panel{background:#12243a;border:1px solid #36506e;padding:26px;border-radius:16px;margin:28px 0}label{display:block;margin:18px 0 4px;font-weight:650}input:not([type=checkbox]),textarea{display:block;width:100%;font:inherit;color:#fff;background:#091729;padding:12px 13px;border:1px solid #6c829d;border-radius:9px}input:focus,textarea:focus{outline:2px solid #38bdf8}fieldset{margin:24px 0;border:1px solid #58728f;border-radius:10px;padding:16px}legend{padding:0 6px;font-weight:700}.checkbox{display:flex;gap:12px;font-weight:400;line-height:1.65;margin:0}.checkbox input{width:22px;height:22px;flex:none;margin-top:5px;accent-color:#38bdf8}button{padding:13px 24px;border:0;border-radius:9px;background:#38bdf8;color:#081220;font-weight:800;font-size:1rem;cursor:pointer}.muted{color:#a0b6ca;font-size:.92rem}footer{border-top:1px solid #36506e;font-size:.88rem}.skip{position:absolute;left:-9999px}.skip:focus{left:10px;top:10px;background:white;color:black;padding:10px}ul{padding-left:24px}@media(max-width:550px){.panel{padding:17px}}
</style>